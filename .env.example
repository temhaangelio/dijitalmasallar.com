# Server only. Required for Gemini speech recordings.
GEMINI_API_KEY=
# Optional local draft locations (never uploaded automatically).
SPEECH_DIR=
SPEECH_DB_PATH=
# Server only. Required to send the e-bulletin; the key belongs to the mail provider (Resend).
MAIL_KEY=
# Sender of every e-bulletin. The domain has to be the one verified with the provider.
MAIL_FROM=Dijital Masallar <bulten@dijitalmasallar.com>
# Google Analytics 4 property for the public site. Optional: the built-in property is used when
# this is empty, and measurement only ever runs on visitor pages, never in the panel.
NEXT_PUBLIC_GA_ID=
